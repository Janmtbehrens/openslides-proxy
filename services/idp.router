    zitadel-api:
      rule: "!PathPrefix(`/ui/v2/login`)"
      service: zitadel-api
      entryPoints:
        - idp
      middlewares:
        - idp-cors
    zitadel-login:
      rule: "PathPrefix(`/ui/v2/login`)"
      service: zitadel-login
      entryPoints:
        - idp
      middlewares:
        - idp-cors
